---
layout: base.njk
title: Archive
description: Everything, oldest to newest.
permalink: /archive/
eleventyExcludeFromCollections: true
---
<div class="wrap">
  <header class="page-header">
    <h1>Archive</h1>
    <p class="dek">{{ collections.posts.length }} post{% if collections.posts.length != 1 %}s{% endif %}.</p>
  </header>

  {%- for group in collections.postsByYear %}
  <section class="year-group">
    <h2 class="year-heading">{{ group.year }}</h2>
    <ul class="compact-list">
      {%- for post in group.posts %}
      <li>
        <time datetime="{{ post.date | htmlDate }}">{{ post.date | readableDate }}</time>
        <a href="{{ post.url }}">{{ post.data.title }}</a>
      </li>
      {%- endfor %}
    </ul>
  </section>
  {%- endfor %}
</div>
