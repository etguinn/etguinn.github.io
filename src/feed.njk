---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title }}</title>
  <subtitle>{{ site.description }}</subtitle>
  <link href="{{ '/feed.xml' | absoluteUrl }}" rel="self"/>
  <link href="{{ '/' | absoluteUrl }}"/>
  <updated>{% if collections.posts.length %}{{ collections.posts[0].date | rfc3339 }}{% else %}{{ build.date | rfc3339 }}{% endif %}</updated>
  <id>{{ '/' | absoluteUrl }}</id>
  <author><name>{{ site.author.name }}</name></author>
  {%- for post in collections.posts %}
  <entry>
    <title>{{ post.data.title }}</title>
    <link href="{{ post.url | absoluteUrl }}"/>
    <updated>{{ post.date | rfc3339 }}</updated>
    <id>{{ post.url | absoluteUrl }}</id>
    <summary>{{ post.data.description or (post.templateContent | excerpt) }}</summary>
    <content type="html">{{ post.templateContent | e }}</content>
  </entry>
  {%- endfor %}
</feed>
