---
layout: base.njk
pagination:
  data: collections.topics
  size: 1
  alias: topic
permalink: "/topics/{{ topic.slug }}/"
eleventyComputed:
  title: "{{ topic.name }}"
  description: "Writing on {{ topic.name | lower }}."
eleventyExcludeFromCollections: true
---
<div class="wrap">
  <header class="page-header">
    <p class="meta"><a href="/topics/">Topics</a></p>
    <h1>{{ topic.name }}</h1>
  </header>
  <ul class="post-list">
    {%- for post in topic.posts %}
    <li class="post-list-item">
      <p class="meta"><time datetime="{{ post.date | htmlDate }}">{{ post.date | readableDate }}</time></p>
      <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
      {%- if post.data.description %}<p class="dek">{{ post.data.description }}</p>{% endif %}
    </li>
    {%- endfor %}
  </ul>
</div>
